pragma solidity 0.8.24;

import {PerpsVault} from "../src/PerpsVault.sol";
import {MockBUSDC} from "../src/dev/MockBUSDC.sol";

interface JsonVm {
    function readFile(string calldata path) external view returns (string memory);
    function parseJsonUint(string calldata json, string calldata key) external pure returns (uint256);
    function parseJsonInt(string calldata json, string calldata key) external pure returns (int256);
    function parseJsonString(string calldata json, string calldata key) external pure returns (string memory);
    function parseJsonAddress(string calldata json, string calldata key) external pure returns (address);
    function parseJsonAddressArray(string calldata json, string calldata key) external pure returns (address[] memory);
    function parseJsonBytes32(string calldata json, string calldata key) external pure returns (bytes32);
    function parseJsonBytes32Array(string calldata json, string calldata key) external pure returns (bytes32[] memory);
    function parseJsonBytes(string calldata json, string calldata key) external pure returns (bytes memory);
    function parseJsonBytesArray(string calldata json, string calldata key) external pure returns (bytes[] memory);
    function toString(uint256 v) external pure returns (string memory);
    function warp(uint256 timestamp) external;
    function chainId(uint256 newChainId) external;
    function prank(address sender) external;
    function startPrank(address sender) external;
    function stopPrank() external;
    function setNonce(address account, uint64 newNonce) external;
    function expectRevert(bytes4 selector) external;
}

/// Round 2, task 2: the vault accepts what the ENGINE produces. Each file of `test/vectors/engine/` is a story
/// generated by `contracts/tools/engine-vectors` from the real engine library, with checkpoints built as the node
/// builds them and signed by the node's own checkpoint code (throwaway 5-of-7 committee): deposits and forced
/// requests the engine consumed, checkpoints, the engine's withdrawal and account proofs, and for every step the
/// effect expected of the vault, computed by the generator's independent restatement of VAULT.md.
///
/// The replay deploys the real `PerpsVault` at the address the vectors were signed for (the address
/// `script/local_deploy.py` gets on a fresh anvil), performs every step, and checks each expected effect. Around
/// each engine-produced item it also tries the tampered and repeated forms, which must be refused.
contract EngineVectorsTest {
    JsonVm internal constant vm = JsonVm(address(uint160(uint256(keccak256("hevm cheat code")))));
    /// anvil's first dev account (a public test address); nonce 0 deploys the token, nonce 1 the vault.
    address internal constant DEPLOYER = 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266;

    MockBUSDC internal token;
    PerpsVault internal vault;
    string internal j;
    address internal feeRecipient;
    uint256 internal checkpointsAccepted;
    uint256 internal checkpointsRefused;
    uint256 internal tamperRefusals;
    uint256 internal payments;

    // ------------------------------------------------------------------ the four stories
    /// deposit -> credited -> withdraw -> paid; forced request -> served; fee sweep record paid to the owner;
    /// forced request ignored -> checkpoint refused -> escape -> claims, refund; launch seeds through the vault.
    function test_engine_story_normal() public {
        _run("normal");
        _eq(checkpointsAccepted, 6, "accepted checkpoints");
        _eq(checkpointsRefused, 1, "the checkpoint that leaves the overdue request is refused");
    }

    /// Insurance first, engine side: the deficit of an underwater account is charged to INSURANCE in the escape
    /// values; the claims sum exactly to custody and every user is paid in full.
    function test_engine_story_insurance_first() public {
        _run("insurance");
        (,,,,,, uint128 totalEscape,,) = vault.latest();
        _eq(totalEscape, vault.escapePool(), "sum of the engine's escape values == the vault's pool, to the unit");
    }

    /// Insurance exhausted: the engine's values exceed custody; the vault's subordination pays users in full from the
    /// BACKSTOP share and only the remainder is left for the system accounts.
    function test_engine_story_backstop_covers_users() public {
        _run("backstop");
        (,,,,,, uint128 totalEscape,,) = vault.latest();
        require(totalEscape > vault.escapePool(), "non-vacuous: the engine's values exceed the pool");
        _eq(vault.escapePayable(), totalEscape - vault.subordinatedTotal(), "users in full");
    }

    /// Deficit beyond both system shares: users share the rest pro rata, the system accounts receive nothing.
    function test_engine_story_shortfall_pro_rata() public {
        _run("shortfall");
        (,,,,,, uint128 totalEscape,,) = vault.latest();
        require(totalEscape - vault.subordinatedTotal() > vault.escapePool(), "non-vacuous: users exceed the pool");
        _eq(vault.escapePayable(), vault.escapePool(), "the whole pool goes to users");
        (, uint64 systemTotal,,) = vault.payouts(vault.escapeKey(address(2)));
        _eq(systemTotal, 0, "nothing registered for INSURANCE / BACKSTOP");
    }

    // ------------------------------------------------------------------ replay
    function _run(string memory story) internal {
        j = vm.readFile(string.concat("test/vectors/engine/", story, ".json"));
        require(keccak256(bytes(_str(".story"))) == keccak256(bytes(story)), "story name");
        vm.chainId(_u(".chainId"));
        vm.warp(1_800_000_000);
        feeRecipient = _a(".feeRecipient");
        vm.setNonce(DEPLOYER, 0);
        vm.startPrank(DEPLOYER);
        token = new MockBUSDC();
        vault = new PerpsVault(_config());
        vm.stopPrank();
        require(address(vault) == _a(".vault"), "the vault is not at the address the vectors were signed for");

        uint256 n = _u(".stepCount");
        for (uint256 i; i < n; ++i) {
            string memory p = string.concat(".steps[", vm.toString(i), "]");
            uint256 t = _u(string.concat(p, ".l2Time"));
            require(t >= block.timestamp, "L2 time never goes back");
            vm.warp(t);
            bytes32 kind = keccak256(bytes(_str(string.concat(p, ".kind"))));
            if (kind == keccak256("deposit")) _deposit(p);
            else if (kind == keccak256("forced")) _forced(p);
            else if (kind == keccak256("checkpoint")) _checkpoint(p);
            else if (kind == keccak256("withdraw")) _withdraw(p);
            else if (kind == keccak256("warp")) {}
            else if (kind == keccak256("triggerEscape")) _trigger(p);
            else if (kind == keccak256("proveSystemShares")) _prove(p);
            else if (kind == keccak256("claimEscape")) _claim(p);
            else if (kind == keccak256("releaseEscape")) _releaseEscape(p);
            else if (kind == keccak256("refund")) _refund(p);
            else if (kind == keccak256("releaseSystem")) _releaseSystem(p);
            else if (kind == keccak256("sweep")) _sweep(p);
            else revert("unknown step kind");
        }
        _final();
    }

    function _config() internal view returns (PerpsVault.Config memory c) {
        c.token = address(token);
        c.feeRecipient = feeRecipient;
        c.validators = vm.parseJsonAddressArray(j, ".validators");
        c.guardians = vm.parseJsonAddressArray(j, ".guardians");
        c.threshold = uint8(_u(".limits.threshold"));
        c.unpauseThreshold = uint8(_u(".limits.unpauseThreshold"));
        c.cap = uint64(_u(".limits.cap"));
        c.minDeposit = uint64(_u(".limits.minDeposit"));
        c.windowLimit = uint64(_u(".limits.windowLimit"));
        c.windowSeconds = uint64(_u(".limits.windowSeconds"));
        c.largeThreshold = uint64(_u(".limits.largeThreshold"));
        c.largeDelay = uint64(_u(".limits.largeDelay"));
        c.forcedDelay = uint64(_u(".limits.forcedDelay"));
        c.escapeDelay = uint64(_u(".limits.escapeDelay"));
        c.pauseDuration = uint64(_u(".limits.pauseDuration"));
        c.pauseCooldown = uint64(_u(".limits.pauseCooldown"));
    }

    function _deposit(string memory p) internal {
        address from = _a(string.concat(p, ".from"));
        uint64 amount = uint64(_u(string.concat(p, ".amount")));
        token.mint(from, amount);
        vm.startPrank(from);
        token.approve(address(vault), amount);
        uint64 index = vault.deposit(amount, _a(string.concat(p, ".account")));
        vm.stopPrank();
        _eq(index, _u(string.concat(p, ".expectIndex")), "deposit index");
    }

    function _forced(string memory p) internal {
        vm.prank(_a(string.concat(p, ".from")));
        uint64 index = vault.requestForced(uint8(_u(string.concat(p, ".forcedKind"))), uint64(_u(string.concat(p, ".arg"))));
        _eq(index, _u(string.concat(p, ".expectIndex")), "forced index");
        _eq(vault.forcedDeadline(index), _u(string.concat(p, ".expectDeadline")), "forced deadline");
    }

    function _cp(string memory p) internal view returns (PerpsVault.Checkpoint memory cp) {
        cp.height = uint64(_u(string.concat(p, ".cp.height")));
        cp.time = uint64(_u(string.concat(p, ".cp.time")));
        cp.logHash = _b32(string.concat(p, ".cp.logHash"));
        cp.accountsRoot = _b32(string.concat(p, ".cp.accountsRoot"));
        cp.marketsRoot = _b32(string.concat(p, ".cp.marketsRoot"));
        cp.withdrawalsRoot = _b32(string.concat(p, ".cp.withdrawalsRoot"));
        cp.nextDepositIndex = uint64(_u(string.concat(p, ".cp.nextDepositIndex")));
        cp.nextForcedIndex = uint64(_u(string.concat(p, ".cp.nextForcedIndex")));
        cp.nextOrderId = uint64(_u(string.concat(p, ".cp.nextOrderId")));
        cp.totalEscape = uint128(_u(string.concat(p, ".cp.totalEscape")));
        cp.dust = uint128(_u(string.concat(p, ".cp.dust")));
        cp.auxHash = _b32(string.concat(p, ".cp.auxHash"));
        cp.depositsHead = _b32(string.concat(p, ".cp.depositsHead"));
        cp.forcedHead = _b32(string.concat(p, ".cp.forcedHead"));
        cp.withdrawalCount = uint64(_u(string.concat(p, ".cp.withdrawalCount")));
        cp.withdrawalsTotal = uint64(_u(string.concat(p, ".cp.withdrawalsTotal")));
    }

    function _checkpoint(string memory p) internal {
        PerpsVault.Checkpoint memory cp = _cp(p);
        bytes[] memory sigs = vm.parseJsonBytesArray(j, string.concat(p, ".signatures"));
        // the digest the node signed and the state root the engine computed are the vault's own
        require(vault.checkpointDigest(cp) == _b32(string.concat(p, ".digest")), "checkpoint digest (node) != vault");
        require(vault.stateRootOf(cp) == _b32(string.concat(p, ".cp.stateRoot")), "state root (engine) != vault");
        // the engine's chain heads are the vault's own accumulation (R395-1)
        require(cp.depositsHead == vault.depositHead(cp.nextDepositIndex), "deposits head (engine) != vault");
        require(cp.forcedHead == vault.forcedHead(cp.nextForcedIndex), "forced head (engine) != vault");
        bool accept = keccak256(bytes(_str(string.concat(p, ".expect")))) == keccak256("accepted");
        if (!accept) {
            vm.expectRevert(PerpsVault.InvalidCheckpoint.selector);
            vault.submitCheckpoint(cp, sigs);
            checkpointsRefused++;
            return;
        }
        // tampered forms of an engine checkpoint are refused: any signed field changed, four signatures, an
        // unsorted certificate, a repeated signer
        cp.totalEscape += 1;
        vm.expectRevert(PerpsVault.InvalidCertificate.selector);
        vault.submitCheckpoint(cp, sigs);
        cp.totalEscape -= 1;
        cp.accountsRoot = bytes32(uint256(cp.accountsRoot) ^ 1);
        vm.expectRevert(PerpsVault.InvalidCertificate.selector);
        vault.submitCheckpoint(cp, sigs);
        cp.accountsRoot = bytes32(uint256(cp.accountsRoot) ^ 1);
        bytes[] memory four = new bytes[](4);
        for (uint256 i; i < 4; ++i) four[i] = sigs[i];
        vm.expectRevert(PerpsVault.InvalidCertificate.selector);
        vault.submitCheckpoint(cp, four);
        (sigs[0], sigs[1]) = (sigs[1], sigs[0]);
        vm.expectRevert(PerpsVault.InvalidCertificate.selector);
        vault.submitCheckpoint(cp, sigs);
        (sigs[0], sigs[1]) = (sigs[1], sigs[0]);
        bytes memory keep = sigs[1];
        sigs[1] = sigs[0];
        vm.expectRevert(PerpsVault.InvalidCertificate.selector);
        vault.submitCheckpoint(cp, sigs);
        sigs[1] = keep;
        tamperRefusals += 5;

        vault.submitCheckpoint(cp, sigs);
        checkpointsAccepted++;
        _eq(vault.checkpointCount(), _u(string.concat(p, ".expectSeq")), "checkpoint seq");
        (,,,,,,,, bytes32 stateRoot) = vault.latest();
        require(stateRoot == _b32(string.concat(p, ".cp.stateRoot")), "stored state root");
        // the same checkpoint again is refused (height must rise)
        vm.expectRevert(PerpsVault.InvalidCheckpoint.selector);
        vault.submitCheckpoint(cp, sigs);
    }

    function _w(string memory p) internal view returns (PerpsVault.Withdrawal memory w) {
        w.withdrawalId = uint64(_u(string.concat(p, ".w.withdrawalId")));
        w.account = _a(string.concat(p, ".w.account"));
        w.recipient = _a(string.concat(p, ".w.recipient"));
        w.amount = uint64(_u(string.concat(p, ".w.amount")));
        w.height = uint64(_u(string.concat(p, ".w.height")));
    }

    function _withdraw(string memory p) internal {
        PerpsVault.Withdrawal memory w = _w(p);
        bytes32[] memory sib = vm.parseJsonBytes32Array(j, string.concat(p, ".siblings"));
        uint64 seq = uint64(_u(string.concat(p, ".seq")));
        // the engine's leaf bytes are the vault's (SPEC 11): 0x00 || leafData hashed, walked up the engine's siblings
        bytes memory leafData = vm.parseJsonBytes(j, string.concat(p, ".leafData"));
        require(
            keccak256(leafData)
                == keccak256(abi.encodePacked("PPv1wdrl", w.withdrawalId, w.account, w.recipient, w.amount, w.height)),
            "withdrawal leaf bytes (engine) != vault format"
        );
        // tampered: amount, recipient, position
        w.amount += 1;
        vm.expectRevert(PerpsVault.InvalidProof.selector);
        vault.withdraw(seq, w, sib, type(uint64).max);
        w.amount -= 1;
        address r = w.recipient;
        w.recipient = address(0xBAD0BAD0);
        // a fee-account record to anyone but the owner's address is refused before the proof is even read
        vm.expectRevert(w.account == address(1) ? PerpsVault.InvalidWithdrawal.selector : PerpsVault.InvalidProof.selector);
        vault.withdraw(seq, w, sib, type(uint64).max);
        w.recipient = r;
        sib[0] = bytes32(uint256(sib[0]) ^ 1);
        vm.expectRevert(PerpsVault.InvalidProof.selector);
        vault.withdraw(seq, w, sib, type(uint64).max);
        sib[0] = bytes32(uint256(sib[0]) ^ 1);
        tamperRefusals += 3;

        uint256 before = token.balanceOf(w.recipient);
        vm.prank(address(0xCA11E4)); // anyone may submit; the record's recipient is paid
        vault.withdraw(seq, w, sib, type(uint64).max);
        _eq(token.balanceOf(w.recipient) - before, _u(string.concat(p, ".expectPaid")), "withdrawal paid");
        require(w.recipient == _a(string.concat(p, ".expectRecipient")), "withdrawal recipient");
        payments++;
        // no second payment of the same record, against this or any earlier checkpoint that holds it
        for (uint64 q = 1; q <= seq; ++q) {
            if (vault.withdrawalCountAt(q) <= w.withdrawalId) continue;
            vm.expectRevert(q == seq ? PerpsVault.AlreadyRegistered.selector : PerpsVault.InvalidProof.selector);
            vault.withdraw(q, w, sib, type(uint64).max);
        }
    }

    function _trigger(string memory p) internal {
        _eq(vault.escapeReason(), _u(string.concat(p, ".expectReason")), "escape reason");
        vault.triggerEscape();
        _eq(vault.escapePool(), _u(string.concat(p, ".expectPool")), "escape pool");
        (,,,,,, uint128 totalEscape,,) = vault.latest();
        _eq(totalEscape, _u(string.concat(p, ".expectTotalEscape")), "total escape");
    }

    function _acct(string memory p) internal view returns (PerpsVault.Account memory a, bytes32[] memory sib) {
        a.account = _a(string.concat(p, ".a.account"));
        a.index = uint32(_u(string.concat(p, ".a.index")));
        a.balance = int128(vm.parseJsonInt(j, string.concat(p, ".a.balance")));
        a.escapeValue = uint64(_u(string.concat(p, ".a.escapeValue")));
        a.positionsHash = _b32(string.concat(p, ".a.positionsHash"));
        sib = vm.parseJsonBytes32Array(j, string.concat(p, ".siblings"));
        require(
            keccak256(vm.parseJsonBytes(j, string.concat(p, ".leafData")))
                == keccak256(abi.encodePacked("PPv1acct", a.account, a.index, a.balance, a.escapeValue, a.positionsHash)),
            "account leaf bytes (engine) != vault format"
        );
    }

    function _prove(string memory p) internal {
        (PerpsVault.Account memory ins, bytes32[] memory s1) = _acct(string.concat(p, ".insurance"));
        (PerpsVault.Account memory back, bytes32[] memory s2) = _acct(string.concat(p, ".backstop"));
        // an understated insurance share (which would raise the users' ratio) is refused
        if (ins.escapeValue != 0) {
            ins.escapeValue -= 1;
            vm.expectRevert(PerpsVault.InvalidProof.selector);
            vault.proveSystemShares(ins, s1, back, s2);
            ins.escapeValue += 1;
            tamperRefusals++;
        }
        vault.proveSystemShares(ins, s1, back, s2);
        _eq(vault.escapePayable(), _u(string.concat(p, ".expectPayable")), "escape payable");
        _eq(vault.subordinatedTotal(), _u(string.concat(p, ".expectSubordinated")), "subordinated total");
        (address to, uint64 total,, uint64 readyAt) = vault.payouts(vault.escapeKey(address(2)));
        _eq(total, _u(string.concat(p, ".expectSystemRemainder")), "system remainder");
        if (total != 0) {
            require(to == feeRecipient, "system remainder recipient");
            _eq(readyAt, uint256(vault.escapeAt()) + 90 days, "system remainder waits 90 days");
            bytes32 key = vault.escapeKey(address(2));
            vm.expectRevert(PerpsVault.NotReady.selector);
            vault.release(key, type(uint64).max);
        }
    }

    function _claim(string memory p) internal {
        (PerpsVault.Account memory a, bytes32[] memory sib) = _acct(string.concat(p, ".proof"));
        if (keccak256(bytes(_str(string.concat(p, ".expect")))) != keccak256("registered")) {
            vm.expectRevert(PerpsVault.InvalidWithdrawal.selector);
            vault.claimEscape(a, sib, type(uint64).max);
            // ... and an inflated value for that account is not in the engine's tree
            a.escapeValue = 1_000_000;
            vm.expectRevert(PerpsVault.InvalidProof.selector);
            vault.claimEscape(a, sib, type(uint64).max);
            tamperRefusals++;
            return;
        }
        // tampered: a larger escape value, another account at this position
        a.escapeValue += 1;
        vm.expectRevert(PerpsVault.InvalidProof.selector);
        vault.claimEscape(a, sib, type(uint64).max);
        a.escapeValue -= 1;
        address keep = a.account;
        a.account = address(0xBAD0BAD0);
        vm.expectRevert(PerpsVault.InvalidProof.selector);
        vault.claimEscape(a, sib, type(uint64).max);
        a.account = keep;
        tamperRefusals += 2;

        address to = _a(string.concat(p, ".expectRecipient"));
        uint256 before = token.balanceOf(to);
        bytes32 key = vault.claimEscape(a, sib, type(uint64).max);
        (address recipient, uint64 total,,) = vault.payouts(key);
        require(recipient == to, "escape recipient");
        _eq(total, _u(string.concat(p, ".expectAmount")), "escape amount");
        _eq(token.balanceOf(to) - before, _u(string.concat(p, ".expectPaidNow")), "escape paid now");
        if (token.balanceOf(to) != before) payments++;
        vm.expectRevert(PerpsVault.AlreadyRegistered.selector);
        vault.claimEscape(a, sib, type(uint64).max);
    }

    function _releaseEscape(string memory p) internal {
        address to = _a(string.concat(p, ".expectRecipient"));
        uint256 before = token.balanceOf(to);
        bytes32 key = vault.escapeKey(_a(string.concat(p, ".account")));
        vault.release(key, type(uint64).max);
        _eq(token.balanceOf(to) - before, _u(string.concat(p, ".expectPaid")), "delayed escape payout");
        payments++;
    }

    function _refund(string memory p) internal {
        address to = _a(string.concat(p, ".expectRecipient"));
        uint64 index = uint64(_u(string.concat(p, ".index")));
        address account = _a(string.concat(p, ".account"));
        uint64 amount = uint64(_u(string.concat(p, ".amount")));
        uint256 before = token.balanceOf(to);
        vm.expectRevert(PerpsVault.InvalidRefund.selector);
        vault.refundDeposit(index, account, amount + 1);
        vault.refundDeposit(index, account, amount);
        _eq(token.balanceOf(to) - before, amount, "refund");
        vm.expectRevert(PerpsVault.InvalidRefund.selector);
        vault.refundDeposit(index, account, amount);
        payments++;
    }

    function _releaseSystem(string memory p) internal {
        uint256 before = token.balanceOf(feeRecipient);
        bytes32 key = vault.escapeKey(address(2));
        vault.release(key, type(uint64).max);
        _eq(token.balanceOf(feeRecipient) - before, _u(string.concat(p, ".expectPaid")), "system remainder paid");
        payments++;
    }

    function _sweep(string memory p) internal {
        if (keccak256(bytes(_str(string.concat(p, ".expect")))) == keccak256("swept")) {
            uint256 before = token.balanceOf(feeRecipient);
            uint64 amount = vault.sweepEscapeSurplus();
            _eq(amount, _u(string.concat(p, ".expectAmount")), "surplus");
            _eq(token.balanceOf(feeRecipient) - before, amount, "surplus paid");
        }
        vm.expectRevert(PerpsVault.InvalidSurplus.selector);
        vault.sweepEscapeSurplus();
    }

    function _final() internal view {
        _eq(token.balanceOf(address(vault)), _u(".expect.vaultBalance"), "final vault balance");
        _eq(vault.depositedTotal(), _u(".expect.depositedTotal"), "deposited total");
        _eq(vault.withdrawnTotal(), _u(".expect.withdrawnTotal"), "withdrawn total");
        _eq(vault.escapeClaimedTotal(), _u(".expect.escapeClaimedTotal"), "escape claimed total");
        _eq(vault.refundedTotal(), _u(".expect.refundedTotal"), "refunded total");
        _eq(vault.reserved(), 0, "nothing left reserved");
        uint256 count = _u(".expect.receivedCount");
        uint256 sum;
        for (uint256 i; i < count; ++i) {
            string memory p = string.concat(".expect.received[", vm.toString(i), "]");
            uint256 got = token.balanceOf(_a(string.concat(p, ".account")));
            _eq(got, _u(string.concat(p, ".received")), "received");
            sum += got;
        }
        // conservation: every unit deposited is with a recipient or still in the vault; nothing was created or lost
        _eq(sum + token.balanceOf(address(vault)), vault.depositedTotal(), "conservation");
        _eq(token.totalSupply(), vault.depositedTotal(), "supply == deposits (the replay mints only what it deposits)");
        require(checkpointsAccepted >= 2 && tamperRefusals >= 10 && payments >= 3, "non-vacuous replay");
    }

    // ------------------------------------------------------------------ helpers
    function _u(string memory key) internal view returns (uint256) {
        return vm.parseJsonUint(j, key);
    }

    function _a(string memory key) internal view returns (address) {
        return vm.parseJsonAddress(j, key);
    }

    function _b32(string memory key) internal view returns (bytes32) {
        return vm.parseJsonBytes32(j, key);
    }

    function _str(string memory key) internal view returns (string memory) {
        return vm.parseJsonString(j, key);
    }

    function _eq(uint256 a, uint256 b, string memory what) internal pure {
        if (a != b) revert(string.concat(what, ": ", _dec(a), " != ", _dec(b)));
    }

    function _dec(uint256 v) internal pure returns (string memory) {
        if (v == 0) return "0";
        bytes memory out;
        while (v != 0) {
            out = abi.encodePacked(bytes1(uint8(48 + v % 10)), out);
            v /= 10;
        }
        return string(out);
    }
}
